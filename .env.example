# Скопируйте этот файл в .env и заполните своими значениями.
# Токен получить/перевыпустить: @BotFather -> /mybots -> @MethodEmbrowBot -> API Token

BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Необязательно: file_id видео (см. get_file_id.py, как их получить)
VIDEO_ABOUT_FILE_ID=BAACAgIAAxkBAAPIanSS4GULisUdJIhMrhf2l0kLcGkAAnOpAAIBCKhLBKjMThbFhmI9BA
VIDEO_LESSON_FILE_ID=BAACAgIAAxkBAAPKanSS8DlSBVt1zl6F0ync7DOvh50AAnWpAAIBCKhLduBuY83Dy0o9BA

# Необязательно: пути к видео на диске (используются, если file_id не задан
# и файл весит меньше 50 МБ, либо запущен локальный Bot API сервер)
VIDEO_ABOUT_PATH=assets/welcome.mp4
VIDEO_LESSON_PATH=assets/welcome.mp4
